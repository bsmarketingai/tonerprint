{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/global/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/product/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree))/i]",
        "message": "Font not provided by the design system. Available: Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvailabilityBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|state|className|key|ref|className|style|children)$/]",
        "message": "<AvailabilityBadge> doesn't accept that prop. Declared props: children, state, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvailabilityBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:zelena|zluta|cervena|seda|storage)$/]",
        "message": "<AvailabilityBadge> state must be one of 'zelena' | 'zluta' | 'cervena' | 'seda' | 'storage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|fullWidth|loading|disabled|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, fullWidth, loading, disabled, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:a1|a2|a3|a4)$/]",
        "message": "<Button> variant must be one of 'a1' | 'a2' | 'a3' | 'a4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|default|big)$/]",
        "message": "<Button> size must be one of 'small' | 'default' | 'big'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|caption|children|action|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, caption, children, action, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterDrawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|count|children|resultLabel|onReset|className|key|ref|className|style|children)$/]",
        "message": "<FilterDrawer> doesn't accept that prop. Declared props: open, onClose, count, children, resultLabel, onReset, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|searchPlaceholder|cartCount|onMenu|className|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: logo, searchPlaceholder, cartCount, onMenu, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|type|disabled|className|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, count, type, disabled, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:checkbox|radio)$/]",
        "message": "<Checkbox> type must be one of 'checkbox' | 'radio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|caption|tone|onClose|className|key|ref|className|style|children)$/]",
        "message": "<Notification> doesn't accept that prop. Declared props: children, caption, tone, onClose, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:zelena|zluta|cervena|seda|info)$/]",
        "message": "<Notification> tone must be one of 'zelena' | 'zluta' | 'cervena' | 'seda' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pages|onChange|position|className|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, pages, onChange, position, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Pagination> position must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popup'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|caption|children|actions|className|key|ref|className|style|children)$/]",
        "message": "<Popup> doesn't accept that prop. Declared props: open, onClose, caption, children, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Price'] > JSXAttribute > JSXIdentifier[name!=/^(?:vat|novat|original|units|size|user|className|key|ref|className|style|children)$/]",
        "message": "<Price> doesn't accept that prop. Declared props: vat, novat, original, units, size, user, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Price'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Price> size must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|image|code|price|availability|availabilityState|rating|ratingCount|flags|shortDescription|layout|quantity|onQuantityChange|units|canBuy|onBuy|className|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, href, image, code, price, availability, availabilityState, rating, ratingCount, flags, shortDescription, layout, quantity, onQuantityChange, units, canBuy, onBuy, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='availabilityState'] > Literal[value!=/^(?:zelena|zluta|cervena|seda|storage)$/]",
        "message": "<ProductCard> availabilityState must be one of 'zelena' | 'zluta' | 'cervena' | 'seda' | 'storage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:grid|row)$/]",
        "message": "<ProductCard> layout must be one of 'grid' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductFlag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|key|ref|className|style|children)$/]",
        "message": "<ProductFlag> doesn't accept that prop. Declared props: label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductFlag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:flag01|flag02|flag03|flag04|flag05|flag06|flag07|flag08)$/]",
        "message": "<ProductFlag> tone must be one of 'flag01' | 'flag02' | 'flag03' | 'flag04' | 'flag05' | 'flag06' | 'flag07' | 'flag08'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|caption|captionIcon|readMore|readMoreHref|columns|variant|className|key|ref|className|style|children)$/]",
        "message": "<ProductGrid> doesn't accept that prop. Declared props: children, caption, captionIcon, readMore, readMoreHref, columns, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductGrid'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:grid|carousel)$/]",
        "message": "<ProductGrid> variant must be one of 'grid' | 'carousel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quantity'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|units|className|key|ref|className|style|children)$/]",
        "message": "<Quantity> doesn't accept that prop. Declared props: value, min, max, onChange, units, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|count|className|key|ref|className|style|children)$/]",
        "message": "<Rating> doesn't accept that prop. Declared props: value, count, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|height|className|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: variant, width, height, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:image|name|short|price)$/]",
        "message": "<Skeleton> variant must be one of 'image' | 'name' | 'short' | 'price'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabDef'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<TabDef> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|multiline|disabled|className|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, required, multiline, disabled, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
